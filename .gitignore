.Ruserdata
.DS_Store



# Calibration outputs
#Calibration/progress_logs/
#Calibration/diagnostics/
# Regenerable diagnostics outputs (PNG/txt/csv) — keep on disk, not in git
Calibration_real_data_transient/diagnostics/**/*.png
Calibration_real_data_transient/diagnostics/**/*.txt
Calibration_real_data_transient/diagnostics/**/*.csv
# Ephemeral SLURM job logs (Roihu)
Calibration_real_data_transient/progress_logs/
Calibration/runs/
Calibration/tests/
Calibration_real_data/runs/
Calibration_real_data/progress_logs/

#Data
Data/*
.positai

# Compiled Fortran binaries (platform-specific, recompile on each system)
*.so
*.o
*.mod

# logs and stored objects
*.rds
*.log.RDataTmp
.DS_Store

# NextGenC map products: large GeoTIFFs + assembled-deposit duplicates
# (regenerable via build_soc_maps.R; published to Zenodo, not tracked in git)
Reporting/NextgenC_report/SOC_maps/*.tif
Reporting/NextgenC_report/SOC_maps/*.csv
Reporting/NextgenC_report/SOC_maps/*.ods

# Peat extension: Data/ is ignored, but track the fetch script + readme here
# (the downloaded Luke MS-NFI raster stays ignored — large + redownloadable)
!Data/Peat_extension/
Data/Peat_extension/*
!Data/Peat_extension/*.R
!Data/Peat_extension/*.md

# Water extension: same — track script + readme, ignore the Ranta10 lakes data
!Data/Water_extension/
Data/Water_extension/*
!Data/Water_extension/*.R
!Data/Water_extension/*.md

# Forest history: track the distilled NFI growing-stock series (small, citable,
# a pipeline source of truth) + readme; ignore the raw Korhonen 2024 supplement xlsx
!Data/forest_history/
Data/forest_history/*
!Data/forest_history/*.csv
!Data/forest_history/*.md

# Zenodo deposit archive (build artifact)
Reporting/NextgenC_report/*.zip

# Build cruft (LaTeX aux, local pipeline logs, loose reference PDFs)
Documentation/*vibe*
*.log
texput.log
Calibration_real_data_transient/pipeline_local_*.log
Model_functions_real_data_transient/Decomposition_functions/Yasso_original/papers/*.pdf

# Annotated review copy holds the user's PDF notes — local only
Calibration_real_data_transient/documentation/HIKET_calibration_annotated.pdf

# LaTeX build artifacts (manuscript)
manuscript/*.aux
manuscript/*.log
manuscript/*.toc
manuscript/*.out
manuscript/*.fls
manuscript/*.fdb_latexmk
manuscript/*.synctex.gz
manuscript/appendices/*.aux
manuscript/appendices/*.log
manuscript/appendices/*.pdf

# Literature PDFs (copyright + size); keep the tracked catalogue literature/README.md
literature/*.pdf

# Ablation artefacts (regenerable; posteriors are large)
doublechecks/ablation_logs/
doublechecks/ablation_runs/
doublechecks/delta_offset_*.rds

# Data-preparation CODE is code, not data (added 2026-08-12). Data_work.R and the
# SOC baseline builder were collateral of the blanket `Data/*` rule above, so the
# two scripts the whole calibration target depends on were unversioned — worked
# around until now by hand-dated copies (Data_work_pre_SOC_swap_20260804.R).
# Same pattern as the Peat/Water extensions: un-ignore the path, keep the data out.
!Data/Data_work.R
!Data/SOC_homogeneized/
Data/SOC_homogeneized/*
!Data/SOC_homogeneized/*.R
!Data/SOC_homogeneized/*.md

# Local run snapshots (large, regenerable only by re-running the calibration).
# Kept on disk + OneDrive as the comparison basis across prior changes; never in git.
snapshots/
